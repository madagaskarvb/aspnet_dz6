@page "{id:int}"
@model SecureTodo.Pages.Tasks.DeleteModel
@{
    ViewData["Title"] = "Удаление задачи";
}

<h1>Удаление задачи</h1>

<h3>Вы уверены, что хотите удалить задачу?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-2">Заголовок</dt>
        <dd class="col-sm-10">@Model.Task.Title</dd>
        <dt class="col-sm-2">Описание</dt>
        <dd class="col-sm-10">@Model.Task.Description</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Task.Id" />
        <button type="submit" class="btn btn-danger">Удалить</button>
        <a asp-page="./Index" class="btn btn-secondary">Отмена</a>
    </form>
</div>