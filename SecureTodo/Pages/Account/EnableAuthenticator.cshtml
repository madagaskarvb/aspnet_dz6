@page
@model SecureTodo.Pages.Account.EnableAuthenticatorModel
@{
    ViewData["Title"] = "Включение 2FA";
}

<h1>Включение двухфакторной аутентификации</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<ol>
    <li>
        Установите приложение <strong>Google Authenticator</strong> или
        <strong>Microsoft Authenticator</strong>.
    </li>
    <li>Отсканируйте QR-код ниже.</li>
    <li>Введите 6-значный код, который покажет приложение.</li>
</ol>

<div class="row">
    <div class="col-md-4 text-center">
        <img src="data:image/png;base64,@Model.QrCodeBase64"
             alt="QR-код для 2FA"
             class="img-fluid border rounded p-2 bg-white" />
    </div>
    <div class="col-md-8">
        <p>Если не удаётся отсканировать — введите ключ вручную:</p>
        <p>
            <code class="fs-5">@Model.SharedKey</code>
        </p>
        <p class="text-muted">
            Формат: TOTP, 6 цифр, интервал 30 секунд.
        </p>
    </div>
</div>

<hr />

<form method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Input.Code" class="form-label"></label>
        <input asp-for="Input.Code"
               class="form-control"
               inputmode="numeric"
               autocomplete="one-time-code"
               maxlength="7" />
        <span asp-validation-for="Input.Code" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Проверить и включить</button>
    <a asp-page="./Profile" class="btn btn-secondary">Отмена</a>
</form>