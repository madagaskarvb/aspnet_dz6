@page
@model SecureTodo.Pages.Account.TwoFactorLoginModel
@{
    ViewData["Title"] = "Двухфакторная аутентификация";
}

<h1>Введите код из приложения-аутентификатора</h1>
<p class="text-muted">
    Откройте Google Authenticator / Microsoft Authenticator и введите
    6-значный код для этого сайта.
</p>

<form method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Input.Code" class="form-label"></label>
        <input asp-for="Input.Code"
               class="form-control"
               inputmode="numeric"
               autocomplete="one-time-code"
               maxlength="7"
               autofocus />
        <span asp-validation-for="Input.Code" class="text-danger"></span>
    </div>

    <div class="mb-3 form-check">
        <input asp-for="Input.RememberMachine" class="form-check-input" />
        <label asp-for="Input.RememberMachine" class="form-check-label"></label>
    </div>

    <button type="submit" class="btn btn-primary">Войти</button>
</form>